font-family = "Hack Nerd Font Mono"
window-save-state = default
macos-titlebar-style = native
font-size = 14
gtk-toolbar-style = flat
window-theme = ghostty

# mac os
#keybind = super+bracket_right=next_tab
#keybind = super+bracket_left=previous_tab
#keybind = super+o=new_tab
#keybind = super+r=prompt_surface_title

# linux
keybind = alt+right_bracket=next_tab
keybind = alt+left_bracket=previous_tab
keybind = alt+o=new_tab
keybind = alt+r=prompt_surface_title

# split
#keybind = alt+v=new_split:down
#keybind = alt+shift+l=resize_split:right,10
#keybind = alt+shift+equal=equalize_splits
#keybind = alt+shift+j=resize_split:down,10
#keybind = alt+shift+h=resize_split:left,10
#keybind = alt+b=new_split:right
#keybind = alt+x=close_surface
#keybind = alt+f=toggle_split_zoom

keybind = shift+ctrl+k=goto_split:up
keybind = shift+ctrl+j=goto_split:down
keybind = shift+ctrl+h=goto_split:left
keybind = shift+ctrl+l=goto_split:right
