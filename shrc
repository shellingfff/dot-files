
# nvim $(fd | fzf)
function nf() {
  local dir=$1
  if [ -z "$dir" ]; then
    dir="."
  fi
  fzfRes=$(fd -H -E .cache -E .local . $dir | fzf --cycle)

  if [ -n "$fzfRes" ]; then
    nvim "$fzfRes"
  fi
}

# cd $(fd | fzf)
function cf() {
  local dir=$1
  if [ -z $dir ]; then
    dir="."
  fi
  fzfRes=$(fd -H -t d . $dir | fzf --cycle)

  if [ -n "$fzfRes" ]; then
    cd "$fzfRes"
  fi
}

export EDITOR=nvim
